<div class="layui-tab">
  <div class="x-nav">
    <span class="layui-breadcrumb">
      <%= link_to "绘本管理", :admin_books %>
      <a><cite><%= @book.name %></cite></a>
      <a><cite>字幕校正</cite></a>
    </span>
    <%= render 'common/user_info' %>
  </div>

  <div class="x-body">
    <% if @book_page.nil? %>
      <div class="layui-card">
        <div class="layui-card-body">这本绘本还没有字幕数据（picture_book_pages 里没有记录）。</div>
      </div>
    <% elsif @subtitle_payload.nil? %>
      <div class="layui-card">
        <div class="layui-card-body">
          第 <%= @book_page.page_number %> 页的 lines 不是合法 JSON，无法校正：
          <pre class="raw-json"><%= @book_page.lines %></pre>
        </div>
      </div>
    <% else %>
      <div class="layui-btn-container">
        <% @book_pages.each do |page| %>
          <%= link_to "第 #{page.page_number} 页",
                correction_admin_book_path(@book, page_number: page.page_number),
                class: "layui-btn layui-btn-sm#{' layui-btn-primary' unless page.id == @book_page.id}" %>
        <% end %>
      </div>

      <div class="correction-layout">
        <div class="layui-card correction-preview">
          <div class="layui-card-body page-meta">
            <% if @page_image.present? %>
              <div class="preview-stage" id="preview-stage">
                <img src="<%= @page_image %>" class="page-image">
                <div class="preview-subtitle no-pinyin" id="preview-subtitle"></div>
              </div>
              <% if @page_audio.present? && (@subtitle_lines.any? || @char_times.present?) %>
                <div class="preview-controls" id="preview-controls">
                  <button type="button" class="layui-btn layui-btn-sm" id="pv-play">▶ 播放本页</button>
                  <input type="range" id="pv-seek" class="pv-seek" min="0" max="1000" step="1" value="0">
                  <span class="pv-time" id="pv-time">0.00s</span>
                  <button type="button" class="layui-btn layui-btn-sm layui-btn-primary" id="pv-rate">1.0×</button>
                  <button type="button" class="layui-btn layui-btn-sm layui-btn-primary" id="pv-pinyin">拼音</button>
                  <button type="button" class="layui-btn layui-btn-sm layui-btn-primary on" id="pv-subtitle-toggle">字幕</button>
                </div>
                <audio id="pv-audio" preload="auto" src="<%= @page_audio %>"></audio>
              <% end %>
            <% end %>
            <div class="meta-text">
              <p>页码：<%= @book_page.page_number %>　页 index：<%= @page_meta["index"] %></p>
              <p>本页朗读：<%= @page_meta["start"] %>s ~ <%= @page_meta["end"] %>s　共 <%= @subtitle_lines.size %> 行</p>
              <% if @char_times %>
                <p>
                  逐字播放时间：<%= @char_times.size %> 项　本页文字：<%= @token_count %> 个
                  <%= @inline_char_times ? "（数量一致，按顺序与文字一一对应）" : "（数量不一致，只能在下方的 char_times 列表里按下标改）" %>
                </p>
              <% end %>
            </div>
          </div>
        </div>

        <div class="correction-editor">
          <div class="layui-btn-container">
            <button type="button" class="layui-btn" id="save-correction">保存本页</button>
            <span class="dirty-tip layui-hide" id="dirty-tip">有未保存的修改</span>
          </div>

          <% if @subtitle_lines.empty? %>
            <div class="layui-card">
              <div class="layui-card-body">本页 lines 里没有可校正的行数据。</div>
            </div>
          <% else %>
            <% char_time_index = 0 %>
            <% @subtitle_lines.each_with_index do |line, line_index| %>
              <% tokens = line.is_a?(Hash) ? Array.wrap(line["tokens"]) : [] %>
              <div class="layui-card">
                <div class="layui-card-header">
                  第 <%= line_index + 1 %> 行
                  <% if line.is_a?(Hash) && (line["start"] || line["end"]) %>
                    <span class="line-time"><%= line["start"] %>s ~ <%= line["end"] %>s</span>
                  <% end %>
                </div>
                <div class="layui-card-body">
                  <% if tokens.empty? %>
                    <span class="empty-tip">该行没有 token</span>
                  <% else %>
                    <div style="overflow-x:auto;">
                      <table class="layui-table token-table">
                        <thead>
                          <tr>
                            <th style="width:30px;">#</th>
                            <% @token_keys.each do |key| %>
                              <th><%= key %></th>
                            <% end %>
                            <th style="width:38px;">重</th>
                            <% if @inline_char_times %>
                              <th style="width:74px;">时间</th>
                            <% end %>
                          </tr>
                        </thead>
                        <tbody>
                          <% tokens.each_with_index do |token, token_index| %>
                            <% keyword = keyword_token?(token) %>
                            <tr class="<%= 'kw-row' if keyword %>">
                              <td><%= token_index %></td>
                              <% @token_keys.each do |key| %>
                                <% owned = token.is_a?(Hash) && token.key?(key) %>
                                <td>
                                  <input type="text" class="layui-input token-input"
                                         data-line="<%= line_index %>"
                                         data-token="<%= token_index %>"
                                         data-key="<%= key %>"
                                         data-owned="<%= owned ? 1 : 0 %>"
                                         value="<%= owned ? token[key] : '' %>">
                                </td>
                              <% end %>
                              <td class="kw-cell">
                                <input type="checkbox" class="kw-input" title="重点字"
                                       data-line="<%= line_index %>"
                                       data-token="<%= token_index %>"
                                       <%= 'checked' if keyword %>>
                              </td>
                              <% if @inline_char_times %>
                                <td>
                                  <input type="number" step="0.01" class="layui-input time-input"
                                         data-time-index="<%= char_time_index %>"
                                         value="<%= @char_times[char_time_index] %>">
                                </td>
                              <% end %>
                              <% char_time_index += 1 %>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>

          <% if @char_times.present? && !@inline_char_times %>
            <div class="layui-card">
              <div class="layui-card-header">
                char_times 逐字播放时间
                <span class="line-time">共 <%= @char_times.size %> 项，与本页 <%= @token_count %> 个文字数量不一致，请按下标核对后修改</span>
              </div>
              <div class="layui-card-body">
                <div style="overflow-x:auto;">
                  <table class="layui-table token-table char-times-table">
                    <thead>
                      <tr>
                        <th style="width:60px;">#</th>
                        <th style="width:150px;">播放时间(s)</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @char_times.each_with_index do |value, index| %>
                        <tr>
                          <td><%= index %></td>
                          <td>
                            <input type="number" step="0.01" class="layui-input time-input"
                                   data-time-index="<%= index %>"
                                   value="<%= value %>">
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% if @book_page && @subtitle_payload && (@subtitle_lines.any? || @char_times.present?) %>
<script>
  // 直接持有库里解析出来的数据，编辑时只改被改动的字段，其余键（image/index/start/end 等）原样带回
  var SUBTITLE_LINES = <%= json_escape(@subtitle_lines.to_json).html_safe %>;
  var CHAR_TIMES = <%= @char_times ? json_escape(@char_times.to_json).html_safe : "null" %>;
  var SAVE_URL = '<%= update_correction_admin_book_path(@book) %>';
  var PAGE_NUMBER = <%= @book_page.page_number %>;

  layui.use(['layer'], function(){
    var layer = layui.layer;
    var $save = $('#save-correction');
    var dirty = false;

    function markDirty(){
      if (dirty) return;
      dirty = true;
      $('#dirty-tip').removeClass('layui-hide');
    }

    // 数字/布尔字段被文本框编辑后不能变成字符串
    function coerce(original, value){
      if (typeof original === 'number' && value.trim() !== '' && !isNaN(Number(value))) return Number(value);
      if (typeof original === 'boolean') return value === 'true' || value === '1';
      return value;
    }

    $('.token-input').on('input', function(){
      var $input = $(this);
      var line = SUBTITLE_LINES[$input.data('line')];
      var token = line && line.tokens && line.tokens[$input.data('token')];
      if (!token) return;

      var key = $input.data('key');
      var value = $input.val();
      if ($input.data('owned') === 1 || value !== '') {
        token[key] = coerce(token[key], value);
      } else {
        delete token[key];
      }
      markDirty();
    });

    // 重点字：勾上写 kw: 1，取消勾就把这个键删掉（约定非重点字不带 kw）
    $('.kw-input').on('change', function(){
      var $input = $(this);
      var line = SUBTITLE_LINES[$input.data('line')];
      var token = line && line.tokens && line.tokens[$input.data('token')];
      if (!token) return;

      var checked = $input.prop('checked');
      if (checked) {
        token.kw = 1;
      } else {
        delete token.kw;
      }
      $input.closest('tr').toggleClass('kw-row', checked);
      markDirty();
    });

    $('.time-input').on('input', function(){
      var $input = $(this);
      var index = $input.data('time-index');
      if (!CHAR_TIMES || CHAR_TIMES[index] === undefined) return;

      var value = $input.val().trim();
      var number = Number(value);
      var valid = value !== '' && !isNaN(number);
      $input.toggleClass('time-invalid', !valid);
      if (valid) CHAR_TIMES[index] = number;
      markDirty();
    });

    $save.on('click', function(){
      var invalid = $('.time-input.time-invalid');
      if (invalid.length) {
        layer.msg('播放时间必须是数字，还有 ' + invalid.length + ' 处不合法', {icon: 2});
        invalid.first().focus();
        return;
      }

      var body = {page_number: PAGE_NUMBER, lines: SUBTITLE_LINES};
      if (CHAR_TIMES) body.char_times = CHAR_TIMES;

      $.ajax({
        url: SAVE_URL,
        type: 'PUT',
        contentType: 'application/json',
        dataType: 'json',
        data: JSON.stringify(body),
        beforeSend: function(){ $save.prop('disabled', true).addClass('layui-btn-disabled'); },
        success: function(res){
          if (res && res.code === 0) {
            dirty = false;
            $('#dirty-tip').addClass('layui-hide');
            layer.msg('保存成功', {icon: 1});
          } else {
            layer.msg((res && res.msg) || '保存失败', {icon: 2});
          }
        },
        error: function(){ layer.msg('保存失败，请重试', {icon: 2}); },
        complete: function(){ $save.prop('disabled', false).removeClass('layui-btn-disabled'); }
      });
    });

    $(window).on('beforeunload', function(){
      if (dirty) return '有未保存的修改，确定离开吗？';
    });

    // ===== 播放预览（移植自绘本播放器的编辑/校准台）=====
    // 以整本朗读音频为时钟，播放本页 [start,end] 区间，逐字高亮。
    // 直接读取上面同一份 SUBTITLE_LINES / CHAR_TIMES，因此在右栏改动时间/文字后，
    // 重新播放即可立刻听到/看到效果，无需先保存。
    var $pvAudio = $('#pv-audio');
    if ($pvAudio.length) {
      var pvAudio = $pvAudio[0];
      var PV_START = <%= (@page_meta["start"] || 0).to_f %>;
      var PV_END = <%= (@page_meta["end"] || 0).to_f %>;
      var PV_HAS_END = PV_END > PV_START;
      var PV_RATES = [1, 1.25, 1.5, 2];
      var pvRateIdx = 0, pvRaf = null, pvToks = [], pvNodes = null;
      var FADE = 3, YELLOW = [255, 210, 63], WHITE = [255, 255, 255], GOLD = [233, 185, 74];

      function pvEscape(s){
        return String(s == null ? '' : s).replace(/[&<>"]/g, function(c){
          return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];
        });
      }
      function pvFlatten(){
        var arr = [];
        (typeof SUBTITLE_LINES !== 'undefined' ? SUBTITLE_LINES : []).forEach(function(line){
          ((line && line.tokens) || []).forEach(function(tk){ arr.push(tk); });
        });
        return arr;
      }
      function pvCharTimes(){
        return (typeof CHAR_TIMES !== 'undefined' && CHAR_TIMES && CHAR_TIMES.length === pvToks.length) ? CHAR_TIMES : null;
      }
      function pvRender(){
        pvToks = pvFlatten();
        var html = pvToks.map(function(tk, i){
          var kw = tk && (tk.kw === 1 || tk.kw === true || tk.kw === '1');
          return '<span class="pv-tok' + (kw ? ' kw' : '') + '" data-i="' + i + '">'
            + '<span class="pv-py">' + pvEscape(tk && tk.py) + '</span>'
            + '<span class="pv-ch">' + pvEscape(tk && tk.ch) + '</span></span>';
        }).join('');
        $('#preview-subtitle').html(html);
        pvNodes = $('#preview-subtitle .pv-tok');
      }
      function pvColor(kw, dist){
        var base = kw ? GOLD : WHITE;
        if (dist < 0 || dist >= FADE) return kw ? 'rgb(233,185,74)' : '#fff';
        var t = dist / FADE;
        var c = [0,1,2].map(function(k){ return Math.round(YELLOW[k] + (base[k] - YELLOW[k]) * t); });
        return 'rgb(' + c[0] + ',' + c[1] + ',' + c[2] + ')';
      }
      // 与播放器一致：优先用逐字绝对时间戳；缺失或数量不匹配时，退化为「行时间 × 字数比例」估算
      function pvCurrentChar(t){
        if (!pvToks.length) return -1;
        var ct = pvCharTimes();
        if (ct) { var idx = -1; for (var i=0;i<ct.length;i++){ if (t >= ct[i]) idx=i; else break; } return idx; }
        var offset = 0, lines = (typeof SUBTITLE_LINES !== 'undefined' ? SUBTITLE_LINES : []);
        for (var li=0; li<lines.length; li++){
          var line=lines[li], tl=((line&&line.tokens)||[]), len=tl.length;
          var ls=(line&&line.start!=null)?line.start:PV_START, le=(line&&line.end!=null)?line.end:PV_END;
          if (t < le){ var span=le-ls, r=span>0?(t-ls)/span:1; return Math.max(-1, Math.min(pvToks.length-1, offset+Math.floor(r*len))); }
          offset += len;
        }
        return pvToks.length - 1;
      }
      function pvHighlight(cur){
        if (!pvNodes) return;
        pvNodes.each(function(){
          var $t=$(this), i=+$t.data('i'), kw=$t.hasClass('kw');
          $t.find('.pv-ch, .pv-py').css('color', pvColor(kw, cur - i));
        });
      }
      function pvEndBound(){
        return PV_HAS_END ? PV_END : (isFinite(pvAudio.duration) && pvAudio.duration ? pvAudio.duration : PV_START + 60);
      }
      function pvUpdate(t){
        var s = PV_START, e = pvEndBound(), span = Math.max(0.0001, e - s);
        var frac = Math.max(0, Math.min(1, (t - s) / span));
        $('#pv-seek').val(Math.round(frac * 1000));
        $('#pv-time').text((t - s).toFixed(2) + 's');
        pvHighlight(pvCurrentChar(t));
      }
      function pvSetPlaying(on){ $('#pv-play').text(on ? '⏸ 暂停' : '▶ 播放本页'); }
      function pvTick(){
        var t = pvAudio.currentTime;
        if (PV_HAS_END && t >= PV_END - 0.01) pvAudio.pause();
        pvUpdate(t);
        if (!pvAudio.paused) pvRaf = requestAnimationFrame(pvTick); else pvRaf = null;
      }
      function pvPlay(){
        var t = pvAudio.currentTime;
        if (!PV_HAS_END || t < PV_START - 0.05 || t >= PV_END - 0.02) { try { pvAudio.currentTime = PV_START; } catch(e){} }
        pvRender();
        var p = pvAudio.play();
        if (p && p.catch) p.catch(function(){});
      }

      $pvAudio.on('error', function(){
        layer.msg('朗读音频加载失败（OSS 签名或权限问题）', {icon: 2});
      });
      $pvAudio.on('play', function(){ pvSetPlaying(true); if (pvRaf == null) pvRaf = requestAnimationFrame(pvTick); });
      $pvAudio.on('pause ended', function(){ pvSetPlaying(false); });

      $('#pv-play').on('click', function(){ if (pvAudio.paused) pvPlay(); else pvAudio.pause(); });
      $('#pv-seek').on('input', function(){
        var s=PV_START, e=pvEndBound(), span=Math.max(0.0001,e-s);
        var t = s + (this.value/1000)*span;
        try { pvAudio.currentTime = t; } catch(e){}
        pvRender(); pvUpdate(t);
      });
      $('#pv-rate').on('click', function(){
        pvRateIdx = (pvRateIdx + 1) % PV_RATES.length;
        var r = PV_RATES[pvRateIdx];
        pvAudio.playbackRate = r;
        $(this).text((r % 1 === 0 ? r.toFixed(1) : String(r)) + '×');
      });
      $('#pv-pinyin').on('click', function(){
        var $s=$('#preview-subtitle'); $s.toggleClass('no-pinyin'); $(this).toggleClass('on', !$s.hasClass('no-pinyin'));
      });
      $('#pv-subtitle-toggle').on('click', function(){
        var $s=$('#preview-subtitle'); $s.toggleClass('hidden'); $(this).toggleClass('on', !$s.hasClass('hidden'));
      });
      // 点字幕里任意字：跳到该字发音处试听（有逐字时间戳才精确）
      $('#preview-subtitle').on('click', '.pv-tok', function(){
        var i=+$(this).data('i'), ct=pvCharTimes(), target = ct ? ct[i] : PV_START, e = pvEndBound();
        try { pvAudio.currentTime = Math.max(PV_START, Math.min(e - 0.01, target)); } catch(err){}
        pvUpdate(pvAudio.currentTime);
        var p2 = pvAudio.play();
        if (p2 && p2.catch) p2.catch(function(){});
      });

      pvRender();
      pvUpdate(PV_START);
    }
  });
</script>
<% end %>

<style>
  /* 左栏页图预览占 70%，右栏字幕编辑占 30%；窄于 992px 时上下堆叠 */
  .correction-layout { display: flex; align-items: flex-start; gap: 16px; }
  .correction-preview { flex: 0 0 70%; max-width: 70%; }
  .correction-editor { flex: 1 1 0; min-width: 0; }
  .page-image { display: block; max-width: 100%; max-height: 80vh; height: auto; }
  .meta-text { margin-top: 12px; }
  .meta-text p { margin: 4px 0; color: #666; }
  @media (max-width: 992px) {
    .correction-layout { flex-direction: column; }
    .correction-preview, .correction-editor { flex: 1 1 auto; width: 100%; max-width: 100%; }
  }
  .line-time { margin-left: 12px; color: #999; font-size: 12px; }
  .token-table td, .token-table th { padding: 6px 4px; }
  /* 右栏只有 30% 宽：固定列按内容收紧、输入框内边距减小，把宽度让给 ch/py；
     最小宽度略小于右栏内宽，1440 下不横滚，窗口更窄时才在 overflow-x 容器里滚 */
  .token-table:not(.char-times-table) { min-width: 320px; }
  .token-table .token-input, .token-table .time-input { height: 32px; padding: 0 6px; }
  .char-times-table { max-width: 260px; }
  .kw-cell { text-align: center; }
  .kw-input { width: 18px; height: 18px; cursor: pointer; vertical-align: middle; }
  .kw-row td { background-color: #fff7f0; }
  .kw-row .token-input { color: #ff5722; font-weight: bold; }
  .time-invalid { border-color: #ff5722 !important; background-color: #fff2f0; }
  .dirty-tip { margin-left: 12px; color: #ff5722; }
  .empty-tip { color: #999; }
  .raw-json { white-space: pre-wrap; word-break: break-all; color: #ff5722; }

  /* ===== 播放预览：仅作用于左栏预览卡内部，不改动页面两栏布局 ===== */
  #pv-audio { display: none; }
  .preview-stage { position: relative; display: inline-block; max-width: 100%; line-height: 0; }
  .preview-subtitle {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-end;
    gap: 4px 6px; padding: 12px 14px; line-height: 1.15; pointer-events: none;
    background: linear-gradient(to top, rgba(0,0,0,.55), rgba(0,0,0,.18) 55%, transparent);
  }
  .preview-subtitle.hidden { display: none; }
  .pv-tok { display: inline-flex; flex-direction: column; align-items: center; pointer-events: auto; cursor: pointer; }
  .pv-tok .pv-py { font-size: 13px; font-weight: 700; color: #fff; -webkit-text-stroke: 1.1px #000; paint-order: stroke fill; }
  .pv-tok .pv-ch { font-size: 20px; font-weight: 700; color: #fff; -webkit-text-stroke: 1.6px #000; paint-order: stroke fill; }
  .preview-subtitle.no-pinyin .pv-py { display: none; }
  .pv-tok.kw .pv-ch { background: #fff; border: 2px solid #e9b94a; border-radius: 6px; padding: 0 4px; }
  .preview-controls { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 10px; line-height: normal; }
  .pv-seek { flex: 1 1 160px; min-width: 120px; }
  .pv-time { min-width: 58px; color: #666; font-size: 12px; font-variant-numeric: tabular-nums; }
  #preview-controls .layui-btn.on { background-color: #ff5722; border-color: #ff5722; color: #fff; }
</style>
